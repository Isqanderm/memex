# Database paths (SQLite — no PostgreSQL needed!)
DATABASE_PATH=data/memex.db
TANTIVY_PATH=data/tantivy
UPLOAD_DIR=data/uploads

# Embeddings (ONNX model downloaded automatically on first run, ~120 MB for e5-small)
LOCAL_EMBEDDING_MODEL=multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# LLM provider: claude | openai
LLM_PROVIDER=openai
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter). When set, OPENAI_LLM_API_KEY is optional.
# Default: Ollama on the Docker host (docker-compose.rust.yml maps host.docker.internal to it).
# Running the binary directly: use http://127.0.0.1:11434/v1. Ollama on another host: use that host's address.
LLM_BASE_URL=http://host.docker.internal:11434/v1

# Reranker: jina-reranker-v2-base-multilingual (default, ~1.1 GB) | bge-reranker-base | bge-reranker-v2-m3 (~2.3 GB)
RERANKER_MODEL=jina-reranker-v2-base-multilingual
# Where fastembed keeps ONNX models. The Docker image pre-downloads them here.
# Code default: data/models.
# Docker: the image sets /app/models, do not set this in Coolify/compose env.
# MODEL_CACHE_DIR=data/models

# Host header values accepted by the MCP endpoint (comma-separated).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,memex

# API keys
# Only for LLM_PROVIDER=claude:
# ANTHROPIC_API_KEY=sk-ant-...
# Only for LLM_PROVIDER=openai against api.openai.com (optional when LLM_BASE_URL is set):
# OPENAI_LLM_API_KEY=sk-...

# Chunking settings
L2_CHUNK_SIZE=512
L1_CHUNK_SIZE=128
L2_CHUNK_OVERLAP=64

# Retrieval settings
SEMANTIC_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANKER_TOP_N=5

# Memory thresholds (cosine similarity; calibrate with scripts/memory_eval.py)
# Existing facts above this similarity are checked for conflicts with a new fact.
MEMORY_CONFLICT_SIMILARITY=0.82
# Minimum similarity for a memory vector hit at retrieval (BM25 hits are fused via RRF).
MEMORY_RETRIEVAL_SIMILARITY=0.60

# Server
HOST=0.0.0.0
PORT=8000

# Template directory path (relative to working directory or absolute)
# TEMPLATES_DIR=templates
