# Database paths (SQLite — no PostgreSQL needed!)
DATABASE_PATH=data/memex.db
TANTIVY_PATH=data/tantivy
UPLOAD_DIR=data/uploads

# Embeddings (ONNX models downloaded automatically on first run ~90MB)
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# LLM provider: claude | openai
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# API keys (one required based on LLM_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_LLM_API_KEY=sk-...

# Chunking settings
L2_CHUNK_SIZE=512
L1_CHUNK_SIZE=128
L2_CHUNK_OVERLAP=64

# Retrieval settings
SEMANTIC_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANKER_TOP_N=5

# Server
HOST=0.0.0.0
PORT=8000
