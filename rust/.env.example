# Database paths (SQLite — no PostgreSQL needed!)
DATABASE_PATH=data/memex.db
TANTIVY_PATH=data/tantivy
UPLOAD_DIR=data/uploads

# Embeddings (ONNX models downloaded automatically on first run ~90MB)
LOCAL_EMBEDDING_MODEL=multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# LLM provider: claude | openai
LLM_PROVIDER=openai
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter). When set, OPENAI_LLM_API_KEY is optional.
# From Docker on macOS/Linux use host.docker.internal instead of localhost.
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# Reranker: jina-reranker-v2-base-multilingual (default, ~1.1 GB) | bge-reranker-base | bge-reranker-v2-m3 (~2.3 GB)
RERANKER_MODEL=jina-reranker-v2-base-multilingual
# Where fastembed keeps ONNX models. The Docker image pre-downloads them here.
# In Docker the image sets MODEL_CACHE_DIR=/app/models (models are baked in); do not override it there.
MODEL_CACHE_DIR=data/models

# Host header values accepted by the MCP endpoint (comma-separated).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,memex

# API keys (one required based on LLM_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_LLM_API_KEY=sk-...

# Chunking settings
L2_CHUNK_SIZE=512
L1_CHUNK_SIZE=128
L2_CHUNK_OVERLAP=64

# Retrieval settings
SEMANTIC_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANKER_TOP_N=5

# Server
HOST=0.0.0.0
PORT=8000

# Template directory path (relative to working directory or absolute)
# TEMPLATES_DIR=templates
