# Database
DATABASE_URL=postgresql+asyncpg://memex:memex@localhost:5432/memex

# OpenAI
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LLM Provider
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
OPENAI_LLM_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...  # раскомментировать если LLM_PROVIDER=claude

# Chunking
L2_CHUNK_SIZE=512
L1_CHUNK_SIZE=128
L2_CHUNK_OVERLAP=64

# Retrieval
SEMANTIC_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANKER_TOP_N=5

# Storage
UPLOAD_DIR=data/uploads
