# ── Database ──────────────────────────────────────────────────────────────────
# When using docker-compose, DATABASE_URL is set automatically from POSTGRES_PASSWORD.
# Only set it manually if running without Compose.
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://memex:change-me-strong-password@localhost:5432/memex

# ── Embeddings (local, no API key required) ──────────────────────────────────
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small  # downloaded on first start

# ── LLM Provider (REQUIRED — pick one) ───────────────────────────────────────
#
# Option A: OpenAI
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_LLM_API_KEY=sk-...
#
# Option B: Claude (comment out Option A above, uncomment below)
# LLM_PROVIDER=claude
# LLM_MODEL=claude-opus-4-5
# ANTHROPIC_API_KEY=sk-ant-...

LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ── Chunking ──────────────────────────────────────────────────────────────────
L2_CHUNK_SIZE=512
L1_CHUNK_SIZE=128
L2_CHUNK_OVERLAP=64

# ── Retrieval ─────────────────────────────────────────────────────────────────
SEMANTIC_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANKER_TOP_N=5

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
