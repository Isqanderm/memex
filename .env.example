# Database
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://memex:change-me-strong-password@localhost:5432/memex
# When using docker-compose, DATABASE_URL is set automatically from POSTGRES_PASSWORD.
# Only override it manually if running the app without Compose.

# OpenAI (required — used for embeddings even if LLM_PROVIDER=claude)
OPENAI_API_KEY=sk-...
OPENAI_LLM_API_KEY=sk-...       # same key, used for LLM calls when LLM_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LLM Provider
LLM_PROVIDER=openai             # openai | claude
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
# ANTHROPIC_API_KEY=sk-ant-...  # uncomment if LLM_PROVIDER=claude

# Chunking
L2_CHUNK_SIZE=512
L1_CHUNK_SIZE=128
L2_CHUNK_OVERLAP=64

# Retrieval
SEMANTIC_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANKER_TOP_N=5

# Storage
UPLOAD_DIR=data/uploads
